# --- Local admin bootstrap (server-side only; never expose in the browser). ---
# Get the service role key from Supabase > Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ADMIN_EMAIL=vktysv@gmail.com
# ADMIN_PASSWORD=choose-a-secure-password

# --- Server-side only (never bundled). Used by scripts/ for schema + seeding. ---
# Paste the full Postgres connection string from Supabase > Settings > Database > URI
# SUPABASE_DB_URL=postgresql://postgres.goyqlyrtclpywvolayzu:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Payment gateway (api/ functions; server-side only, set them in Vercel). ---
# PAYMENT_MODE: mock = internal simulated bank (default), test = İş Bankası test
# environment, production = live POS. The three credentials come from the bank
# (client id, store key) and its documentation (gate URL):
#   test gate:       https://entegrasyon.asseco-see.com.tr/fim/est3Dgate
#   production gate: https://sanalpos.isbank.com.tr/fim/est3Dgate
# Keep the TEST_* placeholders until the real values arrive: mock mode ignores
# them, and test/production refuse to run while any placeholder is still set.
PAYMENT_MODE=mock
PAYMENT_CLIENT_ID=TEST_CLIENT_ID
PAYMENT_STORE_KEY=TEST_STORE_KEY
PAYMENT_GATE_URL=TEST_GATEWAY_URL
# Optional: pin okUrl/failUrl to the canonical domain in production.
# PUBLIC_SITE_URL=https://www.example.org
# The payment functions also need SUPABASE_SERVICE_ROLE_KEY (see above).
