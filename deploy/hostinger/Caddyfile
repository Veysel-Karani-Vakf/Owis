# Edge for the Hostinger VPS: serves the SPA, and fronts the API functions and
# the self-hosted Supabase gateway on the same origin.
#
# SITE_ADDRESS decides TLS: a hostname (staging.example.org) gets an automatic
# certificate; ":80" serves plain HTTP (CI and local runs).

{
	admin off
}

# Container health check only; not published outside the container.
:8081 {
	respond /healthz "ok" 200
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The site is never meant to be framed by another site; the dashboard's
		# own live preview is same-origin and keeps working.
		X-Frame-Options SAMEORIGIN
		# Browsers ignore this over plain HTTP (CI, local runs).
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "{$ROBOTS_TAG:noindex, nofollow}"
		-Server
	}

	# Parity with vercel.json: /donate-now moved permanently to /donate.
	redir /donate-now /donate permanent

	# Self-hosted Supabase, on the exact paths supabase-js calls. Only these
	# three prefixes are forwarded, so the gateway's dashboard stays private.
	@supabase path /auth/v1/* /rest/v1/* /storage/v1/*
	handle @supabase {
		reverse_proxy {$SUPABASE_GATEWAY:supabase-gw:8000}
	}

	# API functions. Request bodies are streamed through untouched, which the
	# bank callback relies on to verify the gateway hash.
	handle /api/* {
		request_body {
			max_size 5MB
		}
		reverse_proxy api:3000
	}

	# Build output with a content hash in the file name: cached for a year. A
	# name that does not exist is a plain 404, never the page shell, so a
	# browser holding an old page fails cleanly instead of loading HTML as
	# a script.
	handle /assets/* {
		root * /srv
		@present file
		header @present Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Link previews of news articles. The apps that build a card for a shared
	# link (WhatsApp, Facebook, Telegram, X, LinkedIn...) do not run the page's
	# script, so the page shell alone only ever gives them the site-wide card.
	# For those apps the API writes the article's own title, summary and
	# picture. Visitors are not affected; and an article the API does not know,
	# or any failure there, gives the apps the ordinary page shell.
	@linkPreview {
		path_regexp ^/news/[^/]+/?$
		header_regexp User-Agent (?i)(facebookexternalhit|facebot|meta-external|whatsapp|telegrambot|twitterbot|linkedinbot|slackbot|discordbot|skypeuripreview|microsoftpreview|pinterest|vkshare|viber|snapchat|redditbot|embedly|iframely|mastodon|bluesky|cardyb)
	}
	handle @linkPreview {
		rewrite * /api/share{path}
		reverse_proxy api:3000 {
			@noCard status 3xx 4xx 5xx
			handle_response @noCard {
				root * /srv
				rewrite * /index.html
				header Cache-Control "no-cache"
				file_server {
					status 200
				}
			}
		}
	}

	# The API not answering at all (a restart) is an error rather than a
	# response: the link-preview apps get the page shell then too.
	handle_errors {
		@cardFallback path /api/share/news/*
		handle @cardFallback {
			root * /srv
			rewrite * /index.html
			header Cache-Control "no-cache"
			file_server {
				status 200
			}
		}
	}

	# Everything else is the single-page app.
	handle {
		root * /srv
		route {
			try_files {path} /index.html
			# The page shell is revalidated on every visit, so a deployment is
			# picked up at once (Vercel does the same). Without this, browsers
			# may keep an old shell that points at files which no longer exist.
			header / Cache-Control "no-cache"
			header /index.html Cache-Control "no-cache"
			file_server
		}
	}
}

# Other names of the site: a permanent redirect to the main address, path and
# query kept. With nothing configured the block answers a name nobody asks for
# over plain HTTP, so no certificate is ever requested for it.
{$REDIRECT_ADDRESSES:http://redirect.invalid} {
	redir {$PUBLIC_SITE_URL:http://localhost}{uri} permanent
}
