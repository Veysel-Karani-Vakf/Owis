# Copy to deploy/hostinger/.env on the server (chmod 600). Never commit .env.

# staging | production. Staging refuses the production Supabase project and
# only runs with PAYMENT_MODE=mock.
DEPLOY_ENV=staging

# What Caddy serves. A hostname gets an automatic HTTPS certificate;
# ":80" serves plain HTTP (local runs and CI).
SITE_ADDRESS=staging.example.org

# Public origin of the site. The browser also reaches Supabase on this origin
# (/auth/v1, /rest/v1, /storage/v1), so there is no separate Supabase URL.
PUBLIC_SITE_URL=https://staging.example.org

# From the self-hosted Supabase project's .env (ANON_KEY / SERVICE_ROLE_KEY).
# The anon key is public and is compiled into the web bundle.
# The service role key bypasses RLS: server-side only.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_MEDIA_BUCKET=media

# mock = built-in simulated bank. The bank credentials stay placeholders until
# a monitored bank test is approved.
PAYMENT_MODE=mock
PAYMENT_CLIENT_ID=TEST_CLIENT_ID
PAYMENT_STORE_KEY=TEST_STORE_KEY
PAYMENT_GATE_URL=TEST_GATEWAY_URL

# Keeps the staging site out of search engines. Use "all" for production.
ROBOTS_TAG=noindex, nofollow

# Tag given to the locally built images (the deploy script sets the commit).
IMAGE_TAG=local
