# Runs share-images apply every 15 minutes (at 7, 22, 37 and 52 past the hour,
# away from the file copy), so an article published with a heavy picture gets
# its light copy without anyone asking for it.
share_images_auto() {
  local unit="owis-share-images"
  case "${1:-status}" in
    on)
      cat > "/etc/systemd/system/$unit.service" <<'UNIT'
[Unit]
Description=OWIS: light copies of heavy news pictures for link previews
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/owis-migrate share-images apply
# 4: another owis-migrate job holds the lock; the next run catches up.
SuccessExitStatus=4
UNIT
      cat > "/etc/systemd/system/$unit.timer" <<'UNIT'
[Unit]
Description=OWIS: look for news pictures that need a light copy every 15 minutes

[Timer]
OnCalendar=*:07/15
AccuracySec=30s

[Install]
WantedBy=timers.target
UNIT
      systemctl daemon-reload
      systemctl enable --now "$unit.timer" > /dev/null 2>&1
      echo "SHARE_AUTO_ON: share-images apply runs every 15 minutes"
      ;;
    off)
      systemctl disable --now "$unit.timer" > /dev/null 2>&1 || true
      echo "SHARE_AUTO_OFF"
      ;;
    status)
      echo "timer: $(systemctl is-active "$unit.timer" 2> /dev/null || true)"
      grep -E '^(== .* link-preview pictures|copies made=|SHARE_)' "$LOG_FILE" 2> /dev/null | tail -n 4 || true
      ;;
    *)
      echo "usage: owis-migrate share-images auto on|off|status" >&2
      exit 2
      ;;
  esac
}

STACK_ENV_FILE="$ROOT/$TARGET_ENV.env"
STACK_COMPOSE_FILE="$ROOT/app/docker-compose.yml"
DEPLOY_TOOL="/usr/local/sbin/owis-deploy-staging"

# One setting of the stack on this server, without its quotes.
stack_value() {
  sed -n "s/^$1=//p" "$STACK_ENV_FILE" | head -n 1 | sed -e "s/^'\(.*\)'\$/\1/"
}

# set_stack_value <name> <value>: stored single-quoted, which docker compose
# reads literally (no variable expansion, no comment). A value with a quote or
# a line break cannot be stored that way and is refused.
set_stack_value() {
  case "$2" in
    *"'"* | *$'\n'*)
      echo "the value of $1 contains a quote or a line break and cannot be stored safely" >&2
      return 1
      ;;
  esac
  grep -v "^$1=" "$STACK_ENV_FILE" > "$STACK_ENV_FILE.new" || true
  printf "%s='%s'\n" "$1" "$2" >> "$STACK_ENV_FILE.new"
  chmod 600 "$STACK_ENV_FILE.new"
  mv "$STACK_ENV_FILE.new" "$STACK_ENV_FILE"
}

remove_stack_value() {
  grep -v "^$1=" "$STACK_ENV_FILE" > "$STACK_ENV_FILE.new" || true
  chmod 600 "$STACK_ENV_FILE.new"
  mv "$STACK_ENV_FILE.new" "$STACK_ENV_FILE"
}

# What docker compose will really hand to the containers, compared with what is
# meant. Catches a value that the settings file would silently alter.
stack_config_check() {
  # stack_config_check <expected environment> <expected payment mode>
  docker compose --project-directory "$ROOT/repo/deploy/hostinger" -f "$STACK_COMPOSE_FILE" \
    --env-file "$STACK_ENV_FILE" config --format json \
    | python3 -c '
import json, sys
config = json.load(sys.stdin)
want_env, want_mode, secrets_file = sys.argv[1:4]
wanted = {}
for line in open(secrets_file):
    if "=" in line:
        key, value = line.rstrip("\n").split("=", 1)
        wanted[key] = value
api = config["services"]["api"]["environment"]
problems = []
if config.get("name") != "owis-staging":
    problems.append("the stack would be renamed to %s" % config.get("name"))
if api.get("DEPLOY_ENV") != want_env:
    problems.append("DEPLOY_ENV is %s" % api.get("DEPLOY_ENV"))
if api.get("PAYMENT_MODE") != want_mode:
    problems.append("PAYMENT_MODE is %s" % api.get("PAYMENT_MODE"))
if want_mode == "production":
    for key in ("PAYMENT_CLIENT_ID", "PAYMENT_STORE_KEY", "PAYMENT_GATE_URL"):
        got = (api.get(key) or "").replace("$$", "$")
        if not wanted.get(key) or got != wanted[key]:
            problems.append("%s does not arrive as stored" % key)
if want_mode == "disabled":
    for key in ("PAYMENT_CLIENT_ID", "PAYMENT_STORE_KEY", "PAYMENT_GATE_URL"):
        if not (api.get(key) or "").startswith("TEST_"):
            problems.append("%s is still handed to the site although payments are off" % key)
for problem in problems:
    print("  " + problem)
sys.exit(1 if problems else 0)
' "$1" "$2" "$PRODUCTION_ENV_FILE"
}

live_answer() {
  # live_answer <path>: the body the public address gives, or nothing.
  curl -sS --max-time 20 "$(stack_value PUBLIC_SITE_URL)$1" 2> /dev/null || true
}

# From the staging settings to the production ones, on the address the stack
# already answers on. The domain is a separate, later step.
promote() {
  local mode="${1:-}" payments="${2:-on}" name value problems=0 target_mode="production"
  case "$mode/$payments" in
    plan/on | apply/on) ;;
    plan/payments-off | apply/payments-off) target_mode="disabled" ;;
    *)
      echo "usage: owis-migrate promote plan|apply [payments-off]" >&2
      exit 2
      ;;
  esac
  echo "== $(date -u +%FT%TZ) promote $mode (online payments: $target_mode)"
  echo "now: DEPLOY_ENV=$(stack_value DEPLOY_ENV) PAYMENT_MODE=$(stack_value PAYMENT_MODE) address=$(stack_value PUBLIC_SITE_URL)"

  [ -s "$IMPORT_STATE_FILE" ] || {
    echo "  the live data has not been imported yet (owis-migrate import apply)"
    problems=1
  }
  if [ "$target_mode" = "production" ]; then
    for name in PAYMENT_CLIENT_ID PAYMENT_STORE_KEY PAYMENT_GATE_URL; do
      value="$(env_value "$name")"
      if [ -z "$value" ]; then
        echo "  $name is missing"
        problems=1
      elif has_control "$value" || [[ "$value" == *"'"* ]]; then
        echo "  $name holds a character that cannot be stored (enter it again)"
        problems=1
      fi
    done
    payment_check | grep -E 'DIFFERENT|WRONG|SUSPECT|MISSING' | sed 's/^/  /' && problems=1
  fi
  grep -q 'name: owis-\${STACK_NAME:-staging}' "$STACK_COMPOSE_FILE" || {
    echo "  $STACK_COMPOSE_FILE is the old copy: it would rename the stack (install the current one first)"
    problems=1
  }
  grep -q ' rebuild)' "$DEPLOY_TOOL" || {
    echo "  $DEPLOY_TOOL is the old copy (no rebuild command)"
    problems=1
  }
  if [ "$target_mode" = "disabled" ] && ! grep -q 'paymentsDisabled' "$ROOT/repo/api/_lib/env.ts" 2> /dev/null; then
    echo "  the deployed build does not know PAYMENT_MODE=disabled yet (deploy the current branch first)"
    problems=1
  fi
  [ "$problems" -eq 0 ] || {
    echo "PROMOTE_NOT_READY. Nothing was changed."
    exit 1
  }
  if [ "$target_mode" = "production" ]; then
    echo "would set: DEPLOY_ENV=production PAYMENT_MODE=production, merchant number, store key and bank address from the stored values"
  else
    echo "would set: DEPLOY_ENV=production PAYMENT_MODE=disabled; no bank value is handed to the site, the checkout shows the notice and the bank accounts"
  fi
  echo "kept as they are: the address, the certificate, the database, the files, the search-engine setting ($(stack_value ROBOTS_TAG))"
  if [ "$mode" = "plan" ]; then
    echo "PROMOTE_PLAN_OK. Nothing was changed."
    return 0
  fi

  local before="$DIR/stack-settings.before-promote.$(date -u +%Y%m%dT%H%M%SZ)"
  cp -p "$STACK_ENV_FILE" "$before"
  restore_settings() {
    cp -p "$before" "$STACK_ENV_FILE"
    echo "the settings from before were put back" >&2
  }

  set_stack_value DEPLOY_ENV production
  set_stack_value PAYMENT_MODE "$target_mode"
  for name in PAYMENT_CLIENT_ID PAYMENT_STORE_KEY PAYMENT_GATE_URL; do
    if [ "$target_mode" = "production" ]; then
      set_stack_value "$name" "$(env_value "$name")"
    else
      remove_stack_value "$name"
    fi
  done
  stack_config_check production "$target_mode" || {
    restore_settings
    echo "PROMOTE_FAILED before anything was restarted" >&2
    exit 1
  }

  if ! "$DEPLOY_TOOL" rebuild; then
    restore_settings
    "$DEPLOY_TOOL" rebuild || echo "the rebuild with the old settings failed too: look at the stack now" >&2
    echo "PROMOTE_FAILED: the stack runs with the settings from before" >&2
    exit 1
  fi

  local health config gate create
  health="$(live_answer /api/healthz)"
  config="$(live_answer /api/payments/config)"
  gate="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 20 -X POST "$(stack_value PUBLIC_SITE_URL)/api/payments/mock-gate" || true)"
  echo "health: $(cut -c1-80 <<< "$health")"
  echo "payments: $(cut -c1-60 <<< "$config")"
  echo "simulated bank page: HTTP $gate (404 means it is switched off)"
  if [ "$target_mode" = "disabled" ]; then
    # An empty request: refused with 503 when payments are off, before anything is read or stored.
    create="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 20 -X POST -H 'Content-Type: application/json' -d '{}' "$(stack_value PUBLIC_SITE_URL)/api/payments/create" || true)"
    echo "starting a payment: HTTP $create (503 means refused because payments are off)"
    [ "$create" = "503" ] || health=""
  fi
  if grep -q '"env":"production"' <<< "$health" && grep -q "\"mode\":\"$target_mode\"" <<< "$config"; then
    echo "PROMOTE_OK. The settings from before are kept in $(basename "$before")"
  else
    echo "the stack started but does not report what was set (see above)" >&2
    restore_settings
    "$DEPLOY_TOOL" rebuild || echo "the rebuild with the old settings failed too: look at the stack now" >&2
    echo "PROMOTE_FAILED: the stack runs with the settings from before" >&2
    exit 1
  fi
}

# ---- the domain ------------------------------------------------------------
# The last step: the official address is served by this stack. It only runs
# when the domain's own name servers already answer with this server's
# address, so the certificate can be issued at once.
CANONICAL_HOST="veysvakfi.org"
WWW_HOST="www.veysvakfi.org"
DOMAIN_NAME_SERVERS="${OWIS_DOMAIN_NAME_SERVERS:-ns1.dns-parking.com ns2.dns-parking.com}"
SUPA_DIR="$ROOT/supabase-$TARGET_ENV"

server_ipv4() {
  ip -4 route get 1.1.1.1 2> /dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n 1
}

# dns_answer <host>: what the domain's own name servers say (no cache in
# between), as "A 1.2.3.4 ttl=300" lines or "CNAME ttl=300".
dns_answer() {
  dns_ask first "$1"
}

# dns_answer_paths <host>: one line for every way of reaching the name
# servers (each of them, over IPv4 and over IPv6) that answered: "A 1.2.3.4",
# "CNAME" or "none". Right after a record changes, some of these can go on
# giving the answer from before for as long as the old record let it be kept.
dns_answer_paths() {
  dns_ask paths "$1"
}

dns_ask() {
  python3 - "$2" "$1" $DOMAIN_NAME_SERVERS <<'PYTHON'
import random, socket, struct, sys

name, mode, servers = sys.argv[1], sys.argv[2], sys.argv[3:]


def ask(server, name, family=socket.AF_INET, address=None):
    query = struct.pack(">HHHHHH", random.randrange(65536), 0, 1, 0, 0, 0)
    query += b"".join(bytes([len(part)]) + part.encode() for part in name.strip(".").split("."))
    query += b"\x00" + struct.pack(">HH", 1, 1)
    sock = socket.socket(family, socket.SOCK_DGRAM)
    sock.settimeout(6)
    sock.sendto(query, address or (socket.gethostbyname(server), 53))
    data, _ = sock.recvfrom(4096)
    sock.close()
    questions, answers = struct.unpack(">HH", data[4:8])
    pos = 12

    def skip(pos):
        while True:
            length = data[pos]
            if length == 0:
                return pos + 1
            if length & 0xC0 == 0xC0:
                return pos + 2
            pos += 1 + length

    for _ in range(questions):
        pos = skip(pos) + 4
    found = []
    for _ in range(answers):
        pos = skip(pos)
        rtype, _rclass, ttl, size = struct.unpack(">HHIH", data[pos:pos + 10])
        pos += 10
        if rtype == 1 and size == 4:
            found.append("A %s ttl=%d" % (socket.inet_ntoa(data[pos:pos + 4]), ttl))
        elif rtype == 5:
            found.append("CNAME ttl=%d" % ttl)
        pos += size
    return found


if mode == "paths":
    seen = set()
    for server in servers:
        try:
            addresses = socket.getaddrinfo(server, 53, type=socket.SOCK_DGRAM)
        except Exception:
            continue
        for family, _type, _proto, _canon, address in addresses:
            if (family, address[0]) in seen:
                continue
            seen.add((family, address[0]))
            try:
                found = ask(server, name, family, address)
            except Exception:  # this way of reaching it does not work from here
                continue
            print(", ".join(sorted(set(line.split(" ttl=")[0] for line in found))) or "none")
    sys.exit(0)

last = None
for server in servers:
    try:
        for line in ask(server, name) or ["none"]:
            print(line)
        sys.exit(0)
    except Exception as error:  # try the next name server
        last = error
print("unknown (%s)" % last)
sys.exit(1)
PYTHON
}

dns_report() {
  local host here
  here="$(server_ipv4)"
  echo "this server: $here"
  for host in "$CANONICAL_HOST" "$WWW_HOST" "staging.$CANONICAL_HOST"; do
    echo "$host: $(dns_answer "$host" | paste -sd, - || true)"
    dns_settling "$host" || true
  done
}

points_here() {
  # points_here <host>: true when the domain's name servers give this server's
  # address, and nothing else, for the host. Every way of reaching them is
  # asked: one that already gives only this server's address shows that the
  # zone itself has changed, even while another still repeats the old answer.
  dns_answer_paths "$1" | grep -qxF "A $(server_ipv4)"
}

dns_settling() {
  # dns_settling <host>: says so, and is true, when the name servers do not
  # all give the same answer for the host yet.
  local answers
  answers="$(dns_answer_paths "$1" | sort -u | paste -sd'|' - || true)"
  case "$answers" in
    *"|"*)
      echo "  note: the name servers do not all give the same answer for $1 yet (${answers//|/ | }); the old one fades within the old record's lifetime, and visitors and the certificate can take that long"
      return 0
      ;;
  esac
  return 1
}

set_supabase_value() {
  # set_supabase_value <name> <value>: one plain line of the Supabase settings file
  grep -v "^$1=" "$SUPA_DIR/.env" > "$SUPA_DIR/.env.new" || true
  printf '%s=%s\n' "$1" "$2" >> "$SUPA_DIR/.env.new"
  chmod 600 "$SUPA_DIR/.env.new"
  mv "$SUPA_DIR/.env.new" "$SUPA_DIR/.env"
}

files_complete() {
  grep -E '^FILES_(COMPLETE|INCOMPLETE)' "$LOG_FILE" 2> /dev/null | tail -n 1 | grep -q '^FILES_COMPLETE'
}

# answers_locally <host> <path>: status the stack itself gives for that host
# name, whatever the rest of the world still has cached.
answers_locally() {
  curl -sS -o /dev/null -w '%{http_code}' --max-time 15 --resolve "$1:443:127.0.0.1" "https://$1$2" 2> /dev/null || true
}

cutover() {
  local mode="${1:-}" files_rule="${2:-}" problems=0
  case "$mode" in
    plan | apply) ;;
    *)
      echo "usage: owis-migrate cutover plan|apply [incomplete-files-ok]" >&2
      exit 2
      ;;
  esac
  local old_url new_url="https://$CANONICAL_HOST" old_host
  old_url="$(stack_value PUBLIC_SITE_URL)"
  old_host="${old_url#https://}"
  echo "== $(date -u +%FT%TZ) cutover $mode"
  echo "now: address=$old_url DEPLOY_ENV=$(stack_value DEPLOY_ENV) PAYMENT_MODE=$(stack_value PAYMENT_MODE)"
  dns_report

  if [ "$old_url" = "$new_url" ]; then
    echo "the stack already serves $new_url"
    exit 0
  fi
  local payments_now
  payments_now="$(stack_value PAYMENT_MODE)"
  [ "$(stack_value DEPLOY_ENV)" = "production" ] && { [ "$payments_now" = "production" ] || [ "$payments_now" = "disabled" ]; } || {
    echo "  the stack still runs with the staging settings (owis-migrate promote apply)"
    problems=1
  }
  [ "$payments_now" != "disabled" ] || echo "  note: online payments are switched off; the checkout shows the notice and the bank accounts"
  if ! files_complete; then
    if [ "$files_rule" = "incomplete-files-ok" ]; then
      echo "  note: the stored files are not all here yet; going on as asked"
    else
      echo "  the stored files are not all here yet (owis-migrate files-copy)"
      problems=1
    fi
  fi
  points_here "$CANONICAL_HOST" || {
    echo "  $CANONICAL_HOST does not point at this server yet"
    problems=1
  }
  points_here "$WWW_HOST" || {
    echo "  $WWW_HOST does not point at this server yet (it needs an A record, not a CNAME)"
    problems=1
  }
  dns_settling "$CANONICAL_HOST" || true
  dns_settling "$WWW_HOST" || true
  echo "would set: address $new_url; $WWW_HOST and $old_host redirect to it; search engines allowed; sign-in links and stored file addresses follow"
  if [ "$mode" = "plan" ]; then
    [ "$problems" -eq 0 ] && echo "CUTOVER_PLAN_OK. Nothing was changed." || echo "CUTOVER_NOT_READY. Nothing was changed."
    return 0
  fi
  [ "$problems" -eq 0 ] || {
    echo "CUTOVER_NOT_READY. Nothing was changed."
    exit 1
  }

  local stamp before_stack before_supabase
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  before_stack="$DIR/stack-settings.before-cutover.$stamp"
  before_supabase="$DIR/supabase-settings.before-cutover.$stamp"
  cp -p "$STACK_ENV_FILE" "$before_stack"
  cp -p "$SUPA_DIR/.env" "$before_supabase"
  undo_cutover() {
    cp -p "$before_stack" "$STACK_ENV_FILE"
    cp -p "$before_supabase" "$SUPA_DIR/.env"
    (cd "$SUPA_DIR" && docker compose up -d --wait --wait-timeout 300 db auth rest storage api-gw > /dev/null 2>&1) || true
    rewrite_urls "$new_url/storage/v1" "$old_url/storage/v1" apply || true
    "$DEPLOY_TOOL" rebuild || echo "the rebuild with the old settings failed too: look at the stack now" >&2
    echo "the settings from before were put back" >&2
  }

  set_stack_value PUBLIC_SITE_URL "$new_url"
  set_stack_value SITE_ADDRESS "$CANONICAL_HOST"
  set_stack_value REDIRECT_ADDRESSES "$WWW_HOST, $old_host"
  set_stack_value ROBOTS_TAG "all"
  stack_config_check production "$payments_now" || {
    cp -p "$before_stack" "$STACK_ENV_FILE"
    echo "CUTOVER_FAILED before anything was restarted" >&2
    exit 1
  }

  # Sign-in service: links in its e-mails and the addresses it accepts.
  set_supabase_value SUPABASE_PUBLIC_URL "$new_url"
  set_supabase_value API_EXTERNAL_URL "$new_url/auth/v1"
  set_supabase_value SITE_URL "$new_url"
  set_supabase_value ADDITIONAL_REDIRECT_URLS "$new_url/**"
  (cd "$SUPA_DIR" && docker compose up -d --wait --wait-timeout 300 db auth rest storage api-gw > /dev/null) || {
    undo_cutover
    echo "CUTOVER_FAILED: the sign-in service did not restart" >&2
    exit 1
  }

  # Uploaded files are stored in the content with their full address.
  rewrite_urls "$old_url/storage/v1" "$new_url/storage/v1" apply

  if ! "$DEPLOY_TOOL" rebuild; then
    undo_cutover
    echo "CUTOVER_FAILED: the stack runs with the settings from before" >&2
    exit 1
  fi

  # The certificate for the new names is requested on the first start.
  local code="" attempt
  for attempt in $(seq 1 36); do
    code="$(answers_locally "$CANONICAL_HOST" /api/healthz)"
    [ "$code" = "200" ] && break
    sleep 5
  done
  echo "https://$CANONICAL_HOST/api/healthz: HTTP ${code:-none}"
  echo "https://$CANONICAL_HOST/: HTTP $(answers_locally "$CANONICAL_HOST" /)"
  echo "https://$CANONICAL_HOST/api/payments/config: HTTP $(answers_locally "$CANONICAL_HOST" /api/payments/config)"
  echo "https://$WWW_HOST/news: HTTP $(answers_locally "$WWW_HOST" /news) (a redirect is expected)"
  echo "https://$old_host/news: HTTP $(answers_locally "$old_host" /news) (a redirect is expected)"
  if [ "$code" = "200" ]; then
    echo "CUTOVER_OK. The settings from before are kept in $(basename "$before_stack") and $(basename "$before_supabase")"
  else
    echo "CUTOVER_UNCONFIRMED: the stack started but $CANONICAL_HOST does not answer over HTTPS yet (certificate?). Nothing was undone." >&2
    exit 1
  fi
}

# Long jobs: one at a time, with their output kept in the log file.
logged() {
  exec 9> "$LOCK_FILE"
  flock -n 9 || {
    echo "another owis-migrate job is running" >&2
    exit 4
  }
  echo "==== $(date -u +%FT%TZ) $COMMAND ${*:2}" >> "$LOG_FILE"
  set +e
  (
    set -e
    "$@"
  ) 2>&1 | tee -a "$LOG_FILE"
  local rc="${PIPESTATUS[0]}"
  set -e
  return "$rc"
}

[ "$(id -u)" -eq 0 ] || {
  echo "must run as root" >&2
  exit 1
}

case "$COMMAND" in
  secrets)
    secrets
    ;;
  state)
    show_state
    ;;
  repair)
    repair
    ;;
  source-test)
    source_test
    ;;
  source-dump)
    logged source_dump
    ;;
  source-changes)
    source_changes "${2:-}"
    ;;
  import)
    logged import_data "${2:-}"
    ;;
  urls)
    logged rewrite_urls "${2:-}" "${3:-}" "${4:-count}"
    ;;
  payment-check)
    payment_check
    ;;
  payment-adopt)
    payment_adopt
    ;;
  store-key)
    store_key
    ;;
  files-auto)
    files_auto "${2:-status}"
    ;;
  promote)
    logged promote "${2:-}" "${3:-on}"
    ;;
  dns)
    dns_report
    ;;
  cutover)
    logged cutover "${2:-}" "${3:-}"
    ;;
  files-test)
    files_test
    ;;
  files-copy)
    logged files_copy "${2:-0}"
    ;;
  files-verify)
    logged files_verify
    ;;
  files-recover)
    logged files_recover "${2:-}" "${3:-plan}"
    ;;
  share-images)
    if [ "${2:-}" = "auto" ]; then
      share_images_auto "${3:-status}"
    else
      logged share_images "${2:-plan}"
    fi
    ;;
  *)
    echo "usage: owis-migrate secrets | state | repair | source-test | source-dump | source-changes [baseline] | import plan|apply | urls <from> <to> [apply] | payment-check | payment-adopt | store-key | promote plan|apply [payments-off] | dns | cutover plan|apply | files-test | files-copy [n] | files-recover <dir> [apply] | files-verify | files-auto on|follow|off|status | share-images plan|apply|force|auto on|off|status" >&2
    exit 2
    ;;
esac
