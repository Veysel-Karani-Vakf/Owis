#!/usr/bin/env bash
# Moves the live site's data from the hosted Supabase project to this server.
# Root-owned, installed in /usr/local/sbin by install-backups.sh.
#
#   owis-migrate secrets        you type the source database password and the
#                               production settings yourself (hidden input);
#                               run it from your own terminal over ssh -t
#   owis-migrate state          which values are stored (never the values)
#   owis-migrate repair         remove what a paste can add around a stored value
#                               (terminal control codes); shows no value
#   owis-migrate source-test    connect to the source and print what is there
#   owis-migrate source-dump    full dump of the source (schemas public, auth,
#                               storage) kept as an encrypted archive in
#                               /var/backups/owis/source, plus a working copy
#   owis-migrate import plan    show what an import would replace; changes nothing
#   owis-migrate import apply   back up this server's database, then replace the
#                               site's tables and the login accounts with the
#                               dumped ones, in one transaction, and compare
#   owis-migrate urls <from> <to> [apply]
#                               count (and with "apply" rewrite) stored addresses
#                               that start with <from>, e.g. the old project's
#   owis-migrate payment-check  compare the stored merchant number with the one
#                               the imported payments were made with
#   owis-migrate files-test     ask the source for one stored file of each kind
#   owis-migrate files-copy [n] copy the stored files (all, or the first n that
#                               are missing) into this server's storage; keeps
#                               the downloaded originals in /opt/owis/migrate/files
#
# Nothing here writes to the source: it is only ever read. The values typed
# into "secrets" are stored root-only in /opt/owis/migrate and never printed.
# The import is data only: tables, policies and functions on this server come
# from supabase/migrations, and are compared with the source, not copied.
set -euo pipefail
umask 077

COMMAND="${1:-}"
ROOT="/opt/owis"
DIR="$ROOT/migrate"
DB_CONTAINER="supabase-db"

# Where the source lives. None of this is secret; the password is.
SOURCE_REF="goyqlyrtclpywvolayzu"
SOURCE_HOST="aws-0-ap-northeast-2.pooler.supabase.com" # session pooler (IPv4)
SOURCE_PORT="5432"
SOURCE_USER="postgres.$SOURCE_REF"
SOURCE_SERVICE_FILE="$DIR/source.service"
SOURCE_KEY_FILE="$DIR/source.service-role-key"
PRODUCTION_ENV_FILE="$DIR/production.env"
DEFAULT_GATE_URL="https://sanalpos.isbank.com.tr/fim/est3Dgate"

# The stack on this server keeps its internal label "staging" (paths, backup
# names) whatever it serves.
TARGET_ENV="staging"
KEY_FILE="$ROOT/backup.key"
WORK_DIR="$DIR/work"
SOURCE_BACKUP_DIR="/var/backups/owis/source"
IMPORT_STATE_FILE="$DIR/imported"
LOG_FILE="/var/log/owis-migrate.log"
LOCK_FILE="/run/owis-migrate.lock"
FILES_DIR="$DIR/files"
SOURCE_STORAGE_URL="${OWIS_SOURCE_STORAGE_URL:-https://$SOURCE_REF.supabase.co/storage/v1}"
TARGET_STORAGE_URL="${OWIS_TARGET_STORAGE_URL:-http://127.0.0.1:8000/storage/v1}"
# Every stored file as one JSON list: bucket, name, size, type, cache setting.
OBJECTS_SQL="select coalesce(json_agg(json_build_object('bucket', bucket_id, 'name', name, 'size', coalesce((metadata->>'size')::bigint, -1), 'type', metadata->>'mimetype', 'cache', metadata->>'cacheControl') order by bucket_id, name), '[]'::json) from storage.objects"

# Row count of every readable table in the three schemas ("schema.table<TAB>count").
COUNTS_SQL="SELECT format('%I.%I', schemaname, tablename), (xpath('/row/c/text()', query_to_xml(format('select count(*) as c from %I.%I', schemaname, tablename), false, true, '')))[1]::text FROM pg_tables WHERE schemaname IN ('public', 'auth', 'storage') AND has_table_privilege(format('%I.%I', schemaname, tablename), 'SELECT') ORDER BY 1"
# One line per row-level policy with a fingerprint of its definition.
POLICIES_SQL="SELECT schemaname || '.' || tablename || '.' || policyname, md5(concat_ws('|', permissive, roles::text, cmd, qual, with_check)) FROM pg_policies WHERE schemaname IN ('public', 'storage') ORDER BY 1"

need_terminal() {
  [ -t 0 ] && [ -t 1 ] || {
    echo "run this from your own terminal (ssh -t ...), not from a script" >&2
    exit 2
  }
}

# Prints the value without what a terminal can wrap around pasted text
# (bracketed-paste markers, arrow or Insert keys) and without blanks around it.
clean_value() {
  local v
  v="$(printf '%s' "$1" | LC_ALL=C sed -E $'s/\x1b\\[[0-9;]*[A-Za-z~]//g')"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  printf '%s' "$v"
}

has_control() {
  [ -n "$(printf '%s' "$1" | LC_ALL=C tr -d '\040-\176\200-\377')" ]
}

# ask_hidden <variable name> <prompt>: reads one line without echo. A value
# that still holds control characters after cleaning is asked for again.
ask_hidden() {
  local __value
  while true; do
    printf '%s: ' "$2"
    read -r -s __value || true
    echo
    __value="$(clean_value "$__value")"
    has_control "$__value" || break
    echo "     that contained control characters (a key pressed during the paste?); once more"
  done
  printf -v "$1" '%s' "$__value"
}

env_value() {
  [ -r "$PRODUCTION_ENV_FILE" ] && sed -n "s/^$1=//p" "$PRODUCTION_ENV_FILE" | head -n 1 || true
}

set_env_value() {
  # set_env_value <name> <value>: replaces or appends one line.
  touch "$PRODUCTION_ENV_FILE"
  grep -v "^$1=" "$PRODUCTION_ENV_FILE" > "$PRODUCTION_ENV_FILE.new" || true
  printf '%s=%s\n' "$1" "$2" >> "$PRODUCTION_ENV_FILE.new"
  mv "$PRODUCTION_ENV_FILE.new" "$PRODUCTION_ENV_FILE"
}

state_line() {
  # state_line <label> <file or value test result>
  if [ "$2" = "yes" ]; then echo "  set      $1"; else echo "  MISSING  $1"; fi
}

show_state() {
  echo "Stored so far (values are never shown):"
  state_line "source database password" "$([ -s "$SOURCE_SERVICE_FILE" ] && echo yes || echo no)"
  state_line "source service_role key (needed for the private files)" "$([ -s "$SOURCE_KEY_FILE" ] && echo yes || echo no)"
  state_line "PAYMENT_CLIENT_ID" "$([ -n "$(env_value PAYMENT_CLIENT_ID)" ] && echo yes || echo no)"
  state_line "PAYMENT_STORE_KEY" "$([ -n "$(env_value PAYMENT_STORE_KEY)" ] && echo yes || echo no)"
  state_line "PAYMENT_GATE_URL" "$([ -n "$(env_value PAYMENT_GATE_URL)" ] && echo yes || echo no)"
}

secrets() {
  need_terminal
  install -d -m 700 "$DIR"
  local value
  # Ask the terminal not to wrap pasted text in control codes.
  printf '\033[?2004l'
  echo "Type or paste each value and press Enter. Nothing you type is shown."
  echo "Press Enter on an empty line to leave a value as it is."
  echo

  echo "1/5  Supabase > Project Settings > Database: the database password."
  echo "     (If it is unknown it can be reset on that page. Type it carefully:"
  echo "     Supabase blocks an address for a while after a few wrong attempts.)"
  ask_hidden value "     database password"
  if [ -n "$value" ]; then
    {
      echo "[owis_source]"
      echo "host=$SOURCE_HOST"
      echo "port=$SOURCE_PORT"
      echo "user=$SOURCE_USER"
      echo "dbname=postgres"
      echo "sslmode=require"
      echo "password=$value"
    } > "$SOURCE_SERVICE_FILE"
  fi

  echo "2/5  Supabase > Project Settings > API keys: the service_role key"
  echo "     (only used to read the private uploaded documents)."
  ask_hidden value "     service_role key"
  [ -z "$value" ] || printf '%s\n' "$value" > "$SOURCE_KEY_FILE"

  echo "3/5  Vercel > Settings > Environment Variables: PAYMENT_CLIENT_ID."
  ask_hidden value "     PAYMENT_CLIENT_ID"
  [ -z "$value" ] || set_env_value PAYMENT_CLIENT_ID "$value"

  echo "4/5  Vercel: PAYMENT_STORE_KEY."
  ask_hidden value "     PAYMENT_STORE_KEY"
  [ -z "$value" ] || set_env_value PAYMENT_STORE_KEY "$value"

  echo "5/5  Vercel: PAYMENT_GATE_URL. Enter alone keeps the bank's production"
  echo "     address ($DEFAULT_GATE_URL)."
  ask_hidden value "     PAYMENT_GATE_URL"
  if [ -n "$value" ]; then
    set_env_value PAYMENT_GATE_URL "$value"
  elif [ -z "$(env_value PAYMENT_GATE_URL)" ]; then
    set_env_value PAYMENT_GATE_URL "$DEFAULT_GATE_URL"
  fi
  unset value
  echo
  show_state
  echo
  echo "SECRETS_STORED. Nothing has been connected or changed yet."
}

# Cleans the values already stored, in place. Never prints one.
repair() {
  local name old new token
  if [ -s "$SOURCE_KEY_FILE" ]; then
    old="$(head -n 1 "$SOURCE_KEY_FILE")"
    token="$(printf '%s' "$old" | LC_ALL=C grep -oE 'eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]{43}' | head -n 1 || true)"
    [ -n "$token" ] || token="$(clean_value "$old")"
    if [ "$token" = "$old" ]; then
      echo "  clean     source service_role key"
    elif [ -z "$token" ] || has_control "$token"; then
      echo "  RE-ENTER  source service_role key (it cannot be cleaned)"
    else
      printf '%s\n' "$token" > "$SOURCE_KEY_FILE.new"
      mv "$SOURCE_KEY_FILE.new" "$SOURCE_KEY_FILE"
      echo "  repaired  source service_role key (stray characters from the paste removed)"
    fi
  fi
  for name in PAYMENT_CLIENT_ID PAYMENT_STORE_KEY PAYMENT_GATE_URL; do
    old="$(env_value "$name")"
    [ -n "$old" ] || continue
    new="$(clean_value "$old")"
    if [ "$new" = "$old" ]; then
      echo "  clean     $name"
    elif [ -z "$new" ] || has_control "$new"; then
      echo "  RE-ENTER  $name (it cannot be cleaned)"
    else
      set_env_value "$name" "$new"
      echo "  repaired  $name (stray characters from the paste removed)"
    fi
  done
}

# Runs a PostgreSQL client program inside the database container against the
# source. The service file travels through stdin and the container's own
# settings (its local password among them) are removed from the environment, so
# they can never be sent to the source by mistake.
source_pg() {
  [ -s "$SOURCE_SERVICE_FILE" ] || {
    echo "the source database password has not been entered yet (owis-migrate secrets)" >&2
    return 3
  }
  docker exec -i "$DB_CONTAINER" sh -c 'umask 077; cat > /tmp/owis-source.service' < "$SOURCE_SERVICE_FILE"
  local rc=0
  docker exec -i "$DB_CONTAINER" env -u PGPASSWORD -u PGHOST -u PGPORT -u PGUSER -u PGDATABASE \
    PGSERVICEFILE=/tmp/owis-source.service PGCONNECT_TIMEOUT=20 "$@" || rc=$?
  docker exec "$DB_CONTAINER" rm -f /tmp/owis-source.service
  return "$rc"
}

source_test() {
  local out rc=0
  out="$(source_pg psql "service=owis_source" -v ON_ERROR_STOP=1 -At -c "
    select 'connected as ' || current_user || ' to PostgreSQL ' || current_setting('server_version');
    select 'database size ' || pg_size_pretty(pg_database_size(current_database()));
    select 'public tables ' || count(*) from pg_tables where schemaname = 'public';
    select 'news ' || count(*) from public.news;
    select 'donation_payments ' || count(*) from public.donation_payments;
    select 'auth users ' || count(*) from auth.users;
    select 'stored files ' || count(*) || ', ' || pg_size_pretty(coalesce(sum((metadata->>'size')::bigint), 0)) from storage.objects;
  " 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "$out"
    echo "SOURCE_OK"
    return 0
  fi
  # Show the reason, never the connection details.
  echo "$out" | grep -E 'FATAL|ERROR|error|timeout|not been entered' | head -n 3 | cut -c1-200 >&2 || true
  if grep -q 'password authentication failed' <<< "$out"; then
    echo "The password was refused. Do not retry blindly: enter it again with" >&2
    echo "owis-migrate secrets, then test once." >&2
  fi
  echo "SOURCE_FAILED" >&2
  return 1
}

target_psql() {
  docker exec -i "$DB_CONTAINER" psql -v ON_ERROR_STOP=1 -U supabase_admin -h localhost -d postgres "$@"
}

sha256_of() {
  sha256sum "$1" | cut -d' ' -f1
}

latest_copy() {
  # Directory of the newest working copy made by source-dump, or nothing.
  local stamp
  stamp="$(cat "$WORK_DIR/latest" 2> /dev/null || true)"
  [ -n "$stamp" ] && [ -s "$WORK_DIR/source-$stamp/db.dump" ] && echo "$WORK_DIR/source-$stamp" || true
}

# Full dump of the source. The dump, the row counts and the policy fingerprints
# read one exported snapshot, so they describe the same moment.
source_dump() {
  [ -s "$KEY_FILE" ] || {
    echo "missing $KEY_FILE (run install-backups.sh)" >&2
    exit 1
  }
  install -d -m 700 "$SOURCE_BACKUP_DIR" "$WORK_DIR"
  local stamp work payload archive copy item
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  work="$(mktemp -d "$WORK_DIR/.dump.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -rf '$work'; docker exec '$DB_CONTAINER' sh -c 'rm -f /tmp/owis-source.*' > /dev/null 2>&1 || true" EXIT
  payload="$work/payload"
  mkdir "$payload" "$work/gnupg"
  archive="$SOURCE_BACKUP_DIR/owis-source-$stamp.tar.gpg"

  echo "== $(date -u +%FT%TZ) dump of the source database"
  docker exec "$DB_CONTAINER" sh -c 'rm -f /tmp/owis-source.dump /tmp/owis-source.counts /tmp/owis-source.policies /tmp/owis-source.rc /tmp/owis-source.skipped'
  source_pg psql "service=owis_source" -v ON_ERROR_STOP=1 -q <<SQL
BEGIN ISOLATION LEVEL REPEATABLE READ, READ ONLY;
SET LOCAL search_path = public, extensions;
SELECT pg_export_snapshot() AS snap \gset
SELECT coalesce(string_agg(format('--exclude-table=%I.%I', schemaname, tablename), ' '), '') AS excl FROM pg_tables WHERE schemaname IN ('public', 'auth', 'storage') AND NOT has_table_privilege(format('%I.%I', schemaname, tablename), 'SELECT') \gset
\setenv OWIS_SNAPSHOT :snap
\setenv OWIS_EXCLUDE :excl
\! echo "\$OWIS_EXCLUDE" > /tmp/owis-source.skipped
\! pg_dump -d "service=owis_source" -Fc -Z 6 --snapshot="\$OWIS_SNAPSHOT" -n public -n auth -n storage \$OWIS_EXCLUDE -f /tmp/owis-source.dump; echo "\$?" > /tmp/owis-source.rc
\pset tuples_only on
\pset format unaligned
\pset fieldsep '\t'
\o /tmp/owis-source.counts
$COUNTS_SQL;
\o /tmp/owis-source.policies
$POLICIES_SQL;
\o
COMMIT;
SQL
  [ "$(docker exec "$DB_CONTAINER" cat /tmp/owis-source.rc 2> /dev/null || echo 1)" = "0" ] || {
    echo "pg_dump did not finish; nothing was kept" >&2
    exit 1
  }
  docker exec "$DB_CONTAINER" sh -c 'pg_restore -l /tmp/owis-source.dump | grep -q "TABLE DATA public news "'
  docker cp -q "$DB_CONTAINER:/tmp/owis-source.dump" "$payload/db.dump"
  docker cp -q "$DB_CONTAINER:/tmp/owis-source.counts" "$payload/counts.tsv"
  docker cp -q "$DB_CONTAINER:/tmp/owis-source.policies" "$payload/policies.tsv"
  docker cp -q "$DB_CONTAINER:/tmp/owis-source.skipped" "$payload/skipped.txt"
  docker exec "$DB_CONTAINER" sh -c 'rm -f /tmp/owis-source.*'
  [ -s "$payload/db.dump" ] && [ -s "$payload/counts.tsv" ]
  if grep -q . "$payload/skipped.txt"; then
    echo "not readable with this account, left out: $(tr -s ' ' < "$payload/skipped.txt" | sed 's/--exclude-table=//g')"
  fi

  local tables rows policies
  tables="$(wc -l < "$payload/counts.tsv" | tr -d ' ')"
  rows="$(awk -F '\t' '{ total += $2 } END { print total + 0 }' "$payload/counts.tsv")"
  policies="$(wc -l < "$payload/policies.tsv" | tr -d ' ')"
  {
    echo "format=1"
    echo "created=$(date -u +%FT%TZ)"
    echo "source=hosted project $SOURCE_REF"
    echo "taken_from=$(hostname)"
    echo "tables=$tables"
    echo "rows=$rows"
    echo "policies=$policies"
    for item in db.dump counts.tsv policies.tsv skipped.txt; do
      echo "bytes_$item=$(stat -c %s "$payload/$item")"
      echo "sha256_$item=$(sha256_of "$payload/$item")"
    done
  } > "$payload/MANIFEST"

  tar -C "$payload" -cf - MANIFEST db.dump counts.tsv policies.tsv skipped.txt \
    | gpg --homedir "$work/gnupg" --batch --quiet --yes --pinentry-mode loopback \
      --passphrase-file "$KEY_FILE" --symmetric --cipher-algo AES256 --compress-algo none \
      -o "$archive.partial"
  local listed
  listed="$(gpg --homedir "$work/gnupg" --batch --quiet --pinentry-mode loopback \
    --passphrase-file "$KEY_FILE" -d "$archive.partial" | tar -tf - | sort | tr '\n' ' ')"
  [ "$listed" = "MANIFEST counts.tsv db.dump policies.tsv skipped.txt " ] || {
    echo "archive does not read back correctly" >&2
    rm -f "$archive.partial"
    exit 1
  }
  mv "$archive.partial" "$archive"
  (cd "$SOURCE_BACKUP_DIR" && sha256sum "$(basename "$archive")" > "$(basename "$archive").sha256")

  # Working copy for the import: the same files, root only.
  copy="$WORK_DIR/source-$stamp"
  mv "$payload" "$copy"
  echo "$stamp" > "$WORK_DIR/latest"

  awk -F '\t' '$1 ~ /^public\./ || $1 == "auth.users" || $1 == "auth.identities" || $1 == "storage.objects" { printf "  %-34s %s\n", $1, $2 }' "$copy/counts.tsv"
  echo "SOURCE_DUMP_OK archive=$(basename "$archive") bytes=$(stat -c %s "$archive") tables=$tables rows=$rows policies=$policies"
}

# Tables an import replaces: every table of the site, and the login accounts.
import_tables() {
  # import_tables <working copy>
  awk -F '\t' '$1 ~ /^public\./ || $1 == "auth.users" || $1 == "auth.identities" { print $1 }' "$1/counts.tsv"
}

import_data() {
  local mode="${1:-}" copy
  case "$mode" in
    plan | apply) ;;
    *)
      echo "usage: owis-migrate import plan|apply" >&2
      exit 2
      ;;
  esac
  copy="$(latest_copy)"
  [ -n "$copy" ] || {
    echo "no working copy of the source yet (owis-migrate source-dump)" >&2
    exit 1
  }
  echo "== $(date -u +%FT%TZ) import $mode, from $(basename "$copy")"

  local tables name bad=0
  tables="$(import_tables "$copy")"
  while read -r name; do
    [[ "$name" =~ ^(public|auth)\.[a-z_][a-z0-9_]*$ ]] || {
      echo "unexpected table name in the source: $name" >&2
      bad=1
    }
  done <<< "$tables"
  [ "$bad" -eq 0 ] || exit 1

  # 1. Same set of site tables on both sides.
  local source_public target_public
  source_public="$(grep '^public\.' <<< "$tables" | sort)"
  target_public="$(target_psql -At -c "select 'public.' || tablename from pg_tables where schemaname = 'public' order by 1" | sort)"
  if [ "$source_public" != "$target_public" ]; then
    echo "the site tables differ between the source and this server:" >&2
    diff <(echo "$source_public") <(echo "$target_public") >&2 || true
    exit 1
  fi

  # 2. What emptying these tables reaches through foreign keys. Anything outside
  #    the site's own tables and the login system stops the import.
  local reached outside extra
  reached="$(target_psql -At <<'SQL'
WITH RECURSIVE hit(oid) AS (
  SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
   WHERE c.relkind IN ('r', 'p')
     AND (n.nspname = 'public' OR (n.nspname = 'auth' AND c.relname IN ('users', 'identities')))
  UNION
  SELECT k.conrelid FROM pg_constraint k JOIN hit ON k.confrelid = hit.oid WHERE k.contype = 'f'
)
SELECT n.nspname || '.' || c.relname
  FROM hit JOIN pg_class c ON c.oid = hit.oid JOIN pg_namespace n ON n.oid = c.relnamespace
 ORDER BY 1;
SQL
  )"
  outside="$(grep -v -E '^(public|auth)\.' <<< "$reached" || true)"
  [ -z "$outside" ] || {
    echo "refused: emptying the tables would also empty: $outside" >&2
    exit 1
  }
  extra="$(comm -23 <(sort <<< "$reached") <(sort <<< "$tables") | tr '\n' ' ')"

  # 3. Before / after picture.
  local now
  now="$(target_psql -At -F $'\t' -c "$COUNTS_SQL")"
  echo "table                               source   here now"
  while read -r name; do
    printf '  %-34s %6s   %6s\n' "$name" \
      "$(awk -F '\t' -v t="$name" '$1 == t { print $2 }' "$copy/counts.tsv")" \
      "$(awk -F '\t' -v t="$name" '$1 == t { print $2 }' <<< "$now")"
  done <<< "$tables"
  echo "also emptied here (sign-in sessions and tokens of the test accounts): ${extra:-none}"
  echo "source rows that are not brought over (they only matter inside the old project):"
  awk -F '\t' '$1 ~ /^auth\./ && $1 != "auth.users" && $1 != "auth.identities" && $2 > 0 { printf "  %-34s %s\n", $1, $2 }' "$copy/counts.tsv"
  echo "stored files are a separate step: storage.objects in the source has $(awk -F '\t' '$1 == "storage.objects" { print $2 }' "$copy/counts.tsv") rows"

  if [ "$mode" = "plan" ]; then
    echo "IMPORT_PLAN_OK. Nothing was changed."
    return 0
  fi

  # 4. Independent backup of this server before anything is replaced.
  local backup_line
  backup_line="$(/usr/local/sbin/owis-backup run "$TARGET_ENV" | grep '^backup written:' || true)"
  [ -n "$backup_line" ] || {
    echo "the backup of this server failed; nothing was changed" >&2
    exit 1
  }
  echo "this server before the import: $backup_line"

  # 5. The data, as SQL, from the dump: only the chosen tables and the site's
  #    sequences.
  # shellcheck disable=SC2064
  trap "docker exec '$DB_CONTAINER' sh -c 'rm -f /tmp/owis-import.*' > /dev/null 2>&1 || true" EXIT
  docker cp -q "$copy/db.dump" "$DB_CONTAINER:/tmp/owis-import.dump"
  docker exec "$DB_CONTAINER" sh -c 'pg_restore -l /tmp/owis-import.dump' \
    | awk '($4 == "TABLE" && $5 == "DATA" && ($6 == "public" || ($6 == "auth" && ($7 == "users" || $7 == "identities")))) || ($4 == "SEQUENCE" && $5 == "SET" && $6 == "public")' \
    | docker exec -i "$DB_CONTAINER" sh -c 'cat > /tmp/owis-import.list'
  local expected listed
  expected="$(wc -l <<< "$tables" | tr -d ' ')"
  listed="$(docker exec "$DB_CONTAINER" grep -c ' TABLE DATA ' /tmp/owis-import.list || true)"
  [ "$listed" = "$expected" ] || {
    echo "the dump holds data for $listed of the $expected tables; nothing was changed" >&2
    exit 1
  }
  docker exec "$DB_CONTAINER" sh -c 'pg_restore --data-only -L /tmp/owis-import.list -f /tmp/owis-import.sql /tmp/owis-import.dump'

  # 6. One transaction: empty, load, commit. Triggers and foreign-key checks
  #    are off inside it, so every row arrives exactly as it was. Any error
  #    leaves this server untouched.
  local truncate_list out rc=0
  truncate_list="$(paste -sd, <<< "$tables")"
  out="$(mktemp "$WORK_DIR/.import.XXXXXX")"
  {
    echo "BEGIN;"
    echo "SET LOCAL session_replication_role = replica;"
    echo "SET LOCAL lock_timeout = '30s';"
    echo "TRUNCATE TABLE $truncate_list CASCADE;"
    docker exec "$DB_CONTAINER" cat /tmp/owis-import.sql
    echo
    echo "COMMIT;"
  } | target_psql -q > "$out" 2>&1 || rc=$?
  if [ "$rc" -ne 0 ]; then
    # The reason only: an error's context lines can quote a row.
    grep -E '^(ERROR|FATAL|psql:)' "$out" | head -n 5 | cut -c1-300 >&2 || true
    rm -f "$out"
    echo "the import failed and was rolled back; this server is unchanged" >&2
    exit 1
  fi
  grep -c '^NOTICE:  truncate cascades' "$out" | sed 's/^/tables emptied through foreign keys: /' || true
  rm -f "$out"
  docker exec "$DB_CONTAINER" sh -c 'rm -f /tmp/owis-import.*'

  # 7. Compare.
  local after mismatch=0 want have
  after="$(target_psql -At -F $'\t' -c "$COUNTS_SQL")"
  while read -r name; do
    want="$(awk -F '\t' -v t="$name" '$1 == t { print $2 }' "$copy/counts.tsv")"
    have="$(awk -F '\t' -v t="$name" '$1 == t { print $2 }' <<< "$after")"
    if [ "$want" = "$have" ]; then
      printf '  ok        %-34s %s\n' "$name" "$have"
    else
      printf '  MISMATCH  %-34s source %s, here %s\n' "$name" "$want" "$have"
      mismatch=1
    fi
  done <<< "$tables"
  [ "$mismatch" -eq 0 ] || {
    echo "IMPORT_MISMATCH: the row counts differ (the backup taken above restores the previous state)" >&2
    exit 1
  }

  # Policies are not copied; they must simply be the same on both sides.
  local here_policies
  here_policies="$(target_psql -At -F $'\t' -c "SET search_path = public, extensions" -c "$POLICIES_SQL" | grep -v '^SET$')"
  if [ "$here_policies" = "$(cat "$copy/policies.tsv")" ]; then
    echo "access policies: $(wc -l < "$copy/policies.tsv" | tr -d ' ') on both sides, identical"
  else
    echo "access policies differ (name: < source, > here):"
    diff <(cut -f1,2 "$copy/policies.tsv") <(echo "$here_policies") | grep -E '^[<>]' | cut -c1-120 || true
  fi

  {
    echo "timestamp=$(date -u +%FT%TZ)"
    echo "source_copy=$(basename "$copy")"
    echo "backup_before=${backup_line#backup written: }"
  } > "$IMPORT_STATE_FILE"
  echo "IMPORT_OK"
}

# Counts, and with "apply" rewrites, stored addresses that start with <from>.
# Uploaded pictures are saved in the content with their full address, so they
# still point at the old project after an import.
rewrite_urls() {
  local from="${1:-}" to="${2:-}" mode="${3:-count}"
  local origin='^https://[a-z0-9.-]+$'
  [[ "$from" =~ $origin ]] && [[ "$to" =~ $origin ]] && [ "$from" != "$to" ] || {
    echo "usage: owis-migrate urls https://old.example https://new.example [apply]" >&2
    exit 2
  }
  case "$mode" in
    count | apply) ;;
    *) exit 2 ;;
  esac
  echo "== $(date -u +%FT%TZ) addresses $from -> $to ($mode)"
  target_psql -q -v from="$from" -v to="$to" -v mode="$mode" <<'SQL' 2>&1 | sed -n -e 's/^NOTICE:  //p' -e '/^ERROR/p' -e '/^FATAL/p'
BEGIN;
SET LOCAL session_replication_role = replica;
SELECT set_config('owis.url_from', :'from', true) AS a, set_config('owis.url_to', :'to', true) AS b, set_config('owis.url_mode', :'mode', true) AS c \gset ignored_
DO $$
DECLARE
  r record;
  n bigint;
  total bigint := 0;
  url_from text := current_setting('owis.url_from');
  url_to text := current_setting('owis.url_to');
  apply boolean := current_setting('owis.url_mode') = 'apply';
BEGIN
  FOR r IN
    SELECT c.relname AS t, a.attname AS col, format_type(a.atttypid, a.atttypmod) AS typ
      FROM pg_attribute a
      JOIN pg_class c ON c.oid = a.attrelid
      JOIN pg_namespace n ON n.oid = c.relnamespace
     WHERE n.nspname = 'public' AND c.relkind = 'r' AND a.attnum > 0 AND NOT a.attisdropped
       AND a.attgenerated = ''
       AND a.atttypid::regtype::text IN ('text', 'character varying', 'jsonb', 'json', 'text[]', 'character varying[]')
     ORDER BY 1, 2
  LOOP
    EXECUTE format('SELECT count(*) FROM public.%I WHERE %I::text LIKE %L', r.t, r.col, '%' || url_from || '/%') INTO n;
    IF n > 0 THEN
      total := total + n;
      IF apply THEN
        EXECUTE format('UPDATE public.%I SET %I = replace(%I::text, %L, %L)::%s WHERE %I::text LIKE %L',
          r.t, r.col, r.col, url_from || '/', url_to || '/', r.typ, r.col, '%' || url_from || '/%');
        RAISE NOTICE 'rewritten  % row(s) in %.%', n, r.t, r.col;
      ELSE
        RAISE NOTICE 'found      % row(s) in %.%', n, r.t, r.col;
      END IF;
    END IF;
  END LOOP;
  RAISE NOTICE 'URLS_% total=%', CASE WHEN apply THEN 'REWRITTEN' ELSE 'COUNTED' END, total;
END $$;
COMMIT;
SQL
}

# Compares what was typed into "secrets" with the imported payment history,
# without showing either side.
payment_check() {
  local stored used key gate
  stored="$(env_value PAYMENT_CLIENT_ID)"
  key="$(env_value PAYMENT_STORE_KEY)"
  gate="$(env_value PAYMENT_GATE_URL)"
  used="$(target_psql -At -c "select distinct raw_response->>'clientid' from public.donation_payments where gateway_mode = 'production' and raw_response ? 'clientid'")"
  if has_control "$stored$key$gate"; then
    echo "one of the stored payment values holds control characters from a paste: run owis-migrate repair"
  fi
  if [ -z "$stored" ]; then
    echo "PAYMENT_CLIENT_ID  MISSING"
  elif [ -z "$used" ]; then
    echo "PAYMENT_CLIENT_ID  set; no live payment here to compare it with (import first)"
  elif grep -qxF -- "$stored" <<< "$used"; then
    echo "PAYMENT_CLIENT_ID  MATCH: the same merchant number the live payments were made with"
  else
    echo "PAYMENT_CLIENT_ID  DIFFERENT from the merchant number of the live payments: enter it again"
  fi
  if [ -z "$key" ]; then
    echo "PAYMENT_STORE_KEY  MISSING"
  elif [ "$key" = "$stored" ] || grep -qxF -- "$key" <<< "$used"; then
    echo "PAYMENT_STORE_KEY  WRONG: it is the merchant number, not the store key"
  elif has_control "$key" || [[ "$key" =~ [[:space:]] ]] || [[ "$key" == TEST_* ]]; then
    echo "PAYMENT_STORE_KEY  SUSPECT: it contains a control character or a space, or is a placeholder: enter it again"
  else
    echo "PAYMENT_STORE_KEY  set; only the bank can confirm it (it accepts or refuses a signed request)"
  fi
  case "$gate" in
    "$DEFAULT_GATE_URL") echo "PAYMENT_GATE_URL   the bank's production address" ;;
    https://*) echo "PAYMENT_GATE_URL   set to another https address: $(cut -d/ -f3 <<< "$gate")" ;;
    *) echo "PAYMENT_GATE_URL   MISSING or not https" ;;
  esac
}

# Asks the source's file service for the smallest file of each bucket, with the
# service_role key. 200 means the files can be copied now.
files_test() {
  [ -s "$SOURCE_KEY_FILE" ] || {
    echo "the source service_role key has not been entered yet (owis-migrate secrets)" >&2
    exit 3
  }
  command -v python3 > /dev/null && command -v curl > /dev/null || {
    echo "python3 and curl are needed" >&2
    exit 1
  }
  local headers bucket name encoded code
  headers="$(mktemp "$DIR/.headers.XXXXXX")"
  # shellcheck disable=SC2064
  trap "rm -f '$headers' '$headers.body'" EXIT
  {
    printf 'apikey: %s\n' "$(head -n 1 "$SOURCE_KEY_FILE")"
    printf 'Authorization: Bearer %s\n' "$(head -n 1 "$SOURCE_KEY_FILE")"
  } > "$headers"
  for bucket in media submissions; do
    name="$(source_pg psql "service=owis_source" -At -c "select name from storage.objects where bucket_id = '$bucket' and (metadata->>'size')::bigint > 0 order by (metadata->>'size')::bigint, name limit 1")"
    [ -n "$name" ] || {
      echo "$bucket: no file listed"
      continue
    }
    encoded="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$name")"
    code="$(curl -sS -o "$headers.body" -w '%{http_code}' --max-time 60 -H @"$headers" \
      "$SOURCE_STORAGE_URL/object/authenticated/$bucket/$encoded" || true)"
    if [ "$code" = "200" ]; then
      echo "$bucket: HTTP 200, readable"
    else
      echo "$bucket: HTTP $code $(python3 -c 'import json, sys
raw = open(sys.argv[1], "rb").read(2000)
try:
    body = json.loads(raw)
    print(" ".join(str(body.get(k, "")) for k in ("statusCode", "error", "message"))[:160])
except Exception:
    print(raw[:120].decode("utf-8", "replace").replace("\n", " "))' "$headers.body" 2> /dev/null || true)"
    fi
    rm -f "$headers.body"
  done
}

# Copies the stored files: each one is downloaded from the source with the
# service_role key, kept under /opt/owis/migrate/files, and uploaded through
# this server's own storage service under the same bucket and name. A file that
# is already here with the same size is skipped, so the job can be repeated.
files_copy() {
  local limit="${1:-0}"
  [[ "$limit" =~ ^[0-9]+$ ]] || {
    echo "usage: owis-migrate files-copy [how many]" >&2
    exit 2
  }
  [ -s "$SOURCE_KEY_FILE" ] || {
    echo "the source service_role key has not been entered yet (owis-migrate secrets)" >&2
    exit 3
  }
  command -v python3 > /dev/null || {
    echo "python3 is needed" >&2
    exit 1
  }
  install -d -m 700 "$FILES_DIR" "$WORK_DIR"
  local list="$WORK_DIR/objects.source.json" here="$WORK_DIR/objects.here.json" rc=0
  echo "== $(date -u +%FT%TZ) copy of the stored files"
  source_pg psql "service=owis_source" -At -c "$OBJECTS_SQL" > "$list"
  target_psql -At -c "$OBJECTS_SQL" > "$here"

  python3 - "$list" "$here" "$FILES_DIR" "$SOURCE_STORAGE_URL" "$TARGET_STORAGE_URL" \
    "$SOURCE_KEY_FILE" "$ROOT/$TARGET_ENV.env" "$limit" <<'PYTHON' || rc=$?
import json, os, sys, time, urllib.error, urllib.parse, urllib.request

list_path, here_path, files_dir, source_url, target_url, source_key_file, env_file, limit = sys.argv[1:9]
limit = int(limit)
source_key = open(source_key_file).readline().strip()
target_key = ""
for line in open(env_file):
    if line.startswith("SUPABASE_SERVICE_ROLE_KEY="):
        target_key = line.split("=", 1)[1].strip()
if not target_key:
    sys.exit("this server's service key is missing from its settings")

objects = json.load(open(list_path)) or []
here = {(o["bucket"], o["name"]): o["size"] for o in (json.load(open(here_path)) or [])}


def quoted(name):
    return urllib.parse.quote(name, safe="/")


def local_path(o):
    parts = o["name"].split("/")
    if o["name"].startswith("/") or any(p in ("", ".", "..") for p in parts):
        return None
    return os.path.join(files_dir, o["bucket"], *parts)


def download(o, dest):
    if os.path.isfile(dest) and os.path.getsize(dest) == o["size"]:
        return
    os.makedirs(os.path.dirname(dest), mode=0o700, exist_ok=True)
    request = urllib.request.Request(
        "%s/object/authenticated/%s/%s" % (source_url, o["bucket"], quoted(o["name"])),
        headers={"apikey": source_key, "Authorization": "Bearer " + source_key},
    )
    part = dest + ".part"
    with urllib.request.urlopen(request, timeout=300) as response, open(part, "wb") as out:
        while True:
            chunk = response.read(1 << 20)
            if not chunk:
                break
            out.write(chunk)
    got = os.path.getsize(part)
    if got != o["size"]:
        os.remove(part)
        raise RuntimeError("downloaded %d bytes, expected %d" % (got, o["size"]))
    os.replace(part, dest)


def upload(o, src):
    headers = {
        "apikey": target_key,
        "Authorization": "Bearer " + target_key,
        "Content-Type": o.get("type") or "application/octet-stream",
        "Content-Length": str(os.path.getsize(src)),
        "x-upsert": "true",
    }
    if o.get("cache"):
        headers["cache-control"] = o["cache"]
    with open(src, "rb") as body:
        request = urllib.request.Request(
            "%s/object/%s/%s" % (target_url, o["bucket"], quoted(o["name"])),
            data=body, method="POST", headers=headers,
        )
        with urllib.request.urlopen(request, timeout=900) as response:
            response.read()


def reason(error):
    if isinstance(error, urllib.error.HTTPError):
        try:
            body = json.loads(error.read(2000) or b"{}")
            detail = " ".join(str(body.get(k, "")) for k in ("statusCode", "error", "message")).strip()
        except Exception:
            detail = ""
        return ("HTTP %d %s" % (error.code, detail))[:200]
    return str(error)[:200]


copied = already = skipped = failed = 0
copied_bytes = 0
blocked = False
todo = []
for o in objects:
    if here.get((o["bucket"], o["name"])) == o["size"]:
        already += 1
    elif o["size"] < 0 or local_path(o) is None:
        skipped += 1
        print("  skipped   %s/%s (no size or an unusable name)" % (o["bucket"], o["name"]))
    else:
        todo.append(o)
if limit:
    todo = todo[:limit]
print("%d files in the source, %d already here, %d to copy now" % (len(objects), already, len(todo)), flush=True)

for index, o in enumerate(todo, 1):
    dest = local_path(o)
    error = None
    for attempt in range(1, 4):
        try:
            download(o, dest)
            upload(o, dest)
            error = None
            break
        except Exception as exc:  # every failure is reported below
            error = exc
            if isinstance(exc, urllib.error.HTTPError) and exc.code in (400, 401, 402, 403, 404):
                break
            time.sleep(3 * attempt)
    if error is None:
        copied += 1
        copied_bytes += o["size"]
    else:
        failed += 1
        print("  FAILED    %s/%s: %s" % (o["bucket"], o["name"], reason(error)), flush=True)
        if copied == 0 and failed >= 3:
            blocked = True
            break
    if index % 20 == 0:
        print("  ... %d of %d" % (index, len(todo)), flush=True)

print("copied=%d bytes=%d already_here=%d skipped=%d failed=%d" % (copied, copied_bytes, already, skipped, failed))
if blocked:
    print("FILES_BLOCKED: the first files all failed; nothing more was tried")
    sys.exit(5)
sys.exit(1 if failed else 0)
PYTHON

  # What is here now, against the source list.
  target_psql -At -c "$OBJECTS_SQL" > "$here"
  python3 - "$list" "$here" <<'PYTHON'
import json, sys
source = json.load(open(sys.argv[1])) or []
here = {(o["bucket"], o["name"]): o["size"] for o in (json.load(open(sys.argv[2])) or [])}
same = sum(1 for o in source if here.get((o["bucket"], o["name"])) == o["size"])
total = sum(o["size"] for o in source if o["size"] > 0)
print("here with the same size: %d of %d files (%d MB in the source)" % (same, len(source), total // 1048576))
print("FILES_COMPLETE" if same == len(source) else "FILES_INCOMPLETE")
PYTHON
  return "$rc"
}

# Long jobs: one at a time, with their output kept in the log file.
logged() {
  exec 9> "$LOCK_FILE"
  flock -n 9 || {
    echo "another owis-migrate job is running" >&2
    exit 4
  }
  echo "==== $(date -u +%FT%TZ) $COMMAND ${*:2}" >> "$LOG_FILE"
  set +e
  (
    set -e
    "$@"
  ) 2>&1 | tee -a "$LOG_FILE"
  local rc="${PIPESTATUS[0]}"
  set -e
  return "$rc"
}

[ "$(id -u)" -eq 0 ] || {
  echo "must run as root" >&2
  exit 1
}

case "$COMMAND" in
  secrets)
    secrets
    ;;
  state)
    show_state
    ;;
  repair)
    repair
    ;;
  source-test)
    source_test
    ;;
  source-dump)
    logged source_dump
    ;;
  import)
    logged import_data "${2:-}"
    ;;
  urls)
    logged rewrite_urls "${2:-}" "${3:-}" "${4:-count}"
    ;;
  payment-check)
    payment_check
    ;;
  files-test)
    files_test
    ;;
  files-copy)
    logged files_copy "${2:-0}"
    ;;
  *)
    echo "usage: owis-migrate secrets | state | repair | source-test | source-dump | import plan|apply | urls <from> <to> [apply] | payment-check | files-test | files-copy [n]" >&2
    exit 2
    ;;
esac
