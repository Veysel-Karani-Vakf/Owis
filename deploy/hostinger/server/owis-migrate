        print("  stored    share/news/%s.jpg, %d KB, for %s" % (key, size // 1024, path))
    except Exception as error:
        failed += 1
        print("  FAILED    %s: could not store the copy (%s)" % (path, str(error)[:120]))

print("copies made=%d stored=%d failed=%d" % (made, stored, failed))
print("SHARE_IMAGES_OK" if not failed else "SHARE_IMAGES_INCOMPLETE")
