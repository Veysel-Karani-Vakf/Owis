[Unit]
Description=OWIS staging restore test (restores the newest backup into a scratch database)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/owis-restore-test run staging
# Does nothing until an off-site destination is connected.
ExecStart=/usr/local/sbin/owis-restore-test offsite staging
Nice=10
IOSchedulingClass=idle
